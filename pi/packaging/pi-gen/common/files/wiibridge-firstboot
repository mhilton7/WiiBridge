#!/bin/sh
set -eu

rm -f /etc/machine-id
systemd-machine-id-setup
rm -f /etc/ssh/ssh_host_*
if systemctl is-enabled ssh.service >/dev/null 2>&1; then
  ssh-keygen -A
fi
install -d -o root -g wiibridge -m 0750 /etc/wiibridge
install -d -o root -g root -m 0700 /etc/NetworkManager/system-connections
umask 077
admin_token=$(openssl rand -hex 6)
printf '%s\n' "$admin_token" > /etc/wiibridge/admin.token
# X.509 requires a notAfter value. Use a 100-year device lifetime so the
# appliance identity does not require routine certificate renewal.
openssl req -x509 -newkey rsa:3072 -nodes -days 36525 \
  -subj "/CN=wiibridge-setup" \
  -keyout /etc/wiibridge/device.key -out /etc/wiibridge/device.crt
chown root:wiibridge /etc/wiibridge/admin.token \
  /etc/wiibridge/device.key /etc/wiibridge/device.crt
chmod 0640 /etc/wiibridge/admin.token \
  /etc/wiibridge/device.key /etc/wiibridge/device.crt

country=US
if test -r /boot/firmware/wiibridge-country; then
  country=$(tr -d '[:space:]' < /boot/firmware/wiibridge-country)
fi
case "$country" in
  [A-Z][A-Z]) ;;
  *) echo "invalid Wi-Fi country in wiibridge-country" >&2; exit 1 ;;
esac
machine=$(tr -d '[:space:]' < /etc/machine-id)
suffix=$(printf '%s' "$machine" | cut -c1-8)
setup_ssid="WiiBridge-$suffix"
setup_passphrase=$(openssl rand -hex 16)
hostapd_config=/etc/wiibridge/hostapd.conf
{
  printf '%s\n' \
    'interface=wlan0' \
    'driver=nl80211' \
    "ssid=$setup_ssid" \
    "country_code=$country" \
    'ieee80211d=1' \
    'hw_mode=g' \
    'channel=6' \
    'wmm_enabled=0' \
    'auth_algs=1' \
    'wpa=2' \
    'wpa_key_mgmt=WPA-PSK' \
    'rsn_pairwise=CCMP'
  printf 'wpa_passphrase=%s\n' "$setup_passphrase"
} > "$hostapd_config"
chown root:wiibridge "$hostapd_config"
chmod 0640 "$hostapd_config"
{
  printf '%s\n' \
    'WiiBridge secure setup credentials' \
    '' \
    "Setup Wi-Fi SSID: $setup_ssid" \
    "Setup Wi-Fi password: $setup_passphrase" \
    'Management URL: https://10.77.0.1:9443/' \
    'Management username: admin' \
    "Management password: $admin_token" \
    '' \
    'Your browser will warn about the device-unique setup certificate.' \
    'Verify and accept it only while connected to the setup Wi-Fi.' \
    'To force recovery mode, create an empty file named' \
    'wiibridge-recovery on this boot partition and reboot.'
} > /boot/firmware/WIIBRIDGE-SETUP.txt
touch /etc/wiibridge/identity-generated
systemctl disable wiibridge-firstboot.service
